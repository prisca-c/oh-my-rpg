{
  "name": "api-rpg",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "node ace build",
    "dev": "node ace serve",
    "format": "prettier --write .",
    "lint": "eslint .",
    "prettier": "prettier --write .",
    "migrate": "node ace migration:run",
    "migrate:prod": "node ace migration:run --force",
    "start": "node bin/server.js",
    "test": "node ace test",
    "typecheck:backend": "tsc --noEmit -p tsconfig.json",
    "typecheck:frontend": "tsc --noEmit -p src/frontend/tsconfig.json",
    "typecheck": "yarn typecheck:backend && yarn typecheck:frontend"
  },
  "imports": {
    "#app/*": "./app/*.js",
    "#application/*": "./src/backend/application/*.js",
    "#backend/*": "./src/backend/*.js",
    "#common/*": "./src/common/*.js",
    "#core/*": "./src/backend/core/*.js",
    "#domain/*": "./src/backend/domain/*.js",
    "#features/*": "./app/features/*.js",
    "#frontend/*": "./src/frontend/*.js",
    "#infrastructure/*": "./src/backend/infrastructure/*.js",
    "#resources/*": "./resources/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "7.8.2",
    "@adonisjs/eslint-config": "^2.0.0-beta.7",
    "@adonisjs/prettier-config": "^1.4.0",
    "@adonisjs/tsconfig": "^1.4.0",
    "@japa/assert": "^3.0.0",
    "@japa/plugin-adonisjs": "^3.0.0",
    "@japa/runner": "^3.1.1",
    "@swc/core": "^1.4.11",
    "@tanstack/eslint-plugin-query": "^5.60.1",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.74",
    "@types/react-dom": "^18.2.19",
    "@unocss/eslint-config": "^0.64.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "hot-hook": "^0.4.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.0",
    "unocss": "^0.64.0",
    "vite": "^5.2.8"
  },
  "dependencies": {
    "@adonisjs/auth": "^9.2.4",
    "@adonisjs/core": "^6.14.1",
    "@adonisjs/cors": "^2.2.1",
    "@adonisjs/inertia": "2.0.1",
    "@adonisjs/lucid": "21.4.0",
    "@adonisjs/redis": "^9.0.0",
    "@adonisjs/session": "^7.5.0",
    "@adonisjs/shield": "^8.1.1",
    "@adonisjs/static": "^1.1.1",
    "@adonisjs/vite": "3.0.0",
    "@inertiajs/react": "^1.2.0",
    "@poppinss/utils": "^6.7.2",
    "@tanstack/react-query": "^5.61.0",
    "@unocss/reset": "^0.64.0",
    "@vinejs/vine": "2.1.0",
    "adonis-lucid-soft-deletes": "^2.1.0",
    "edge.js": "^6.2.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "immer": "^10.1.1",
    "luxon": "^3.4.4",
    "motion": "^11.11.17",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "reflect-metadata": "^0.2.0",
    "zustand": "^5.0.1"
  },
  "hotHook": {
    "boundaries": [
      "./src/backend/infrastructure/http/controllers/**/*.ts",
      "./src/backend/infrastructure/http/middleware/**/*.ts"
    ]
  },
  "overrides": {
    "strtok3": "9.0.1"
  },
  "resolutions": {
    "strtok3": "9.0.1"
  },
  "pnpm": {
    "overrides": {
      "strtok3": "9.0.1"
    }
  },
  "prettier": "@adonisjs/prettier-config",
  "packageManager": "yarn@4.5.2"
}
