{
  "name": "api-rpg",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "node ace build",
    "dev": "node ace serve",
    "format": "prettier --write .",
    "lint": "eslint .",
    "prettier": "prettier --write .",
    "migrate": "node ace migration:run",
    "migrate:prod": "node ace migration:run --force",
    "start": "node bin/server.js",
    "test": "node ace test",
    "typecheck:backend": "tsc --noEmit -p tsconfig.json",
    "typecheck:frontend": "tsc --noEmit -p src/frontend/tsconfig.json",
    "typecheck": "yarn typecheck:backend && yarn typecheck:frontend"
  },
  "imports": {
    "#app/*": "./app/*.js",
    "#application/*": "./src/backend/application/*.js",
    "#backend/*": "./src/backend/*.js",
    "#common/*": "./src/common/*.js",
    "#core/*": "./src/backend/core/*.js",
    "#database/*": "./database/*.js",
    "#domain/*": "./src/backend/domain/*.js",
    "#features/*": "./app/features/*.js",
    "#frontend/*": "./src/frontend/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#infrastructure/*": "./src/backend/infrastructure/*.js",
    "#resources/*": "./resources/*.js",
    "#transformers/*": "./app/transformers/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@ampproject/remapping": "^2.3.0",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@tanstack/eslint-plugin-query": "^5.60.1",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@unocss/eslint-config": "^66.7.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "hot-hook": "^0.4.0",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.5.15",
    "prettier": "^3.2.5",
    "typescript": "~5.7.0",
    "unocss": "^66.7.0",
    "vite": "^7.3.1",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.3.4",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/inertia": "^4.2.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/redis": "^10.0.0",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/vite": "^5.1.1",
    "@inertiajs/react": "^2.3.16",
    "@poppinss/utils": "^6.7.2",
    "@tanstack/react-query": "^5.61.0",
    "@unocss/reset": "^66.7.0",
    "@vinejs/vine": "^4.4.0",
    "adonis-lucid-soft-deletes": "^2.1.0",
    "edge.js": "^6.5.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "immer": "^10.1.1",
    "luxon": "^3.4.4",
    "motion": "^11.11.17",
    "pg": "^8.11.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.0.1",
    "reflect-metadata": "^0.2.0",
    "zustand": "^5.0.1"
  },
  "hotHook": {
    "boundaries": [
      "./src/backend/infrastructure/http/controllers/**/*.ts",
      "./src/backend/infrastructure/http/middleware/**/*.ts"
    ]
  },
  "overrides": {
    "cookie": "1.0.2",
    "lodash": "4.18.1",
    "send": "1.1.0",
    "strtok3": "9.1.1"
  },
  "resolutions": {
    "strtok3": "9.1.1"
  },
  "pnpm": {
    "overrides": {
      "strtok3": "9.1.1"
    }
  },
  "prettier": "@adonisjs/prettier-config",
  "packageManager": "yarn@4.9.1"
}
